generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id                   String                @id @default(uuid())
  nome                 String
  email                String
  telefone             String
  ultimoContato        DateTime              @default(now())
  totalOrcamentos      Int                   @default(0)
  usuarioId            String
  usuario              Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  orcamentos           Orcamento[]
  solicitacoesWhatsApp SolicitacaoWhatsApp[]
}

model Orcamento {
  id               String            @id @default(uuid())
  descricao        String
  valor            Float
  status           String            @default("pendente")
  motivoRecusa     String?
  dataRecebido     DateTime          @default(now())
  dataAtualizado   DateTime          @updatedAt
  clienteId        String
  usuarioId        String
  dataCancelamento DateTime?
  dataFechamento   DateTime?
  cliente          Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario          Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  eventos          OrcamentoEvento[]
}

model OrcamentoEvento {
  id           String    @id @default(uuid())
  orcamentoId  String
  tipo         String
  descricao    String
  statusAntigo String?
  statusNovo   String?
  criadoEm     DateTime  @default(now())
  orcamento    Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
}

model SolicitacaoWhatsApp {
  id               String   @id @default(uuid())
  usuarioId        String
  clienteId        String
  whatsappFrom     String
  mensagemOriginal String
  clienteNome      String
  criadoEm         DateTime @default(now())
  cliente          Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Configuracao {
  id                    String   @id @default(uuid())
  usuarioId             String   @unique
  corPrimaria           String   @default("224.3 76.3% 48%")
  tema                  String   @default("system")
  templateProposta      String   @default("Olá {{cliente}}, tudo bem? \n\nConforme conversamos, o valor estimado para o serviço fica em *{{valor}}*.\n\nO escopo inclui:\n{{descricao}}\n\nPodemos dar andamento? Qualquer dúvida estou à disposição!")
  templateLembrete      String   @default("Oi {{cliente}}, passando para saber se você conseguiu dar uma olhadinha na nossa proposta ou se ficou com alguma dúvida! 😊")
  templateAgradecimento String   @default("Muito obrigado por fechar conosco, {{cliente}}! Vamos fazer um trabalho incrível. Em breve envio os próximos passos.")
  atualizadoEm          DateTime @updatedAt
  metaConversao         Float    @default(45)
  metaReceita           Float    @default(20000)
  metaContratosSemana   Int      @default(3)
  usuario               Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Usuario {
  id                    String                @id @default(uuid())
  nome                  String
  email                 String                @unique
  senha                 String
  empresa               String?
  telefone              String?
  isAdmin               Boolean               @default(false)
  createdAt             DateTime              @default(now())
  emailVerificado       Boolean               @default(false)
  tokenVerificacaoEmail String?               @unique
  clientes              Cliente[]
  configuracao          Configuracao?
  orcamentos            Orcamento[]
  solicitacoesWhatsApp  SolicitacaoWhatsApp[]
}
